        "huvudbetydelse": "Vrede som väcks av att något är moraliskt orätt",
        "register": "neutral, negativ, allmän",
        "synonymer": [
          "indignation"
        ],
        "synonym_groups": null,
        "exempelmening": "Hans hånfulla ord väckte allmän <font color=\"#3498db\">harm</font>.",
        "etymologi": "Runform harmi, fornsvenska harmber 'sorg, skada, fortrytelse'; gemensamt germanskt ord, belagt pa runsten fran 1000-talet."
