        "register": "ngt ålderdomlig, neutral, allmän",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Reformen innebar <font color=\"#3498db\">tabelras</font> med hela det gamla systemet.",
        "etymologi": "Franska table rase 'rent bord'; av latin tabula rasa '(vax)tavla med utplanad skrift' -- samma rot som tavla."
