      "facit": "påverka, intala",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Påverka någon så att en tanke tas emot utan att prövas ; också: framkalla en stämning eller känsla hos någon",
        "register": "neutral, neutral, psykologi ; neutral, neutral, allmän",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Dekoren <font color=\"#3498db\">suggererade</font> fram den rätta kusliga stämningen.",
        "etymologi": "Latin suggerere 'lagga under, bara fram, ingiva'."
      },
      "verdikt": "godkand",
      "anmarkning": "SO ger 'paverka genom suggestion' samt partikelbruket 'suggerera fram' (framkalla en stamning/kansla) -- bada med pa kortet. Exempelmeningen om dekoren ar SO:s eget exempel nastan ordagrant. Etymologin (lat. suggerere) ar korrekt.",
      "granskning_turer_post": 45,
      "granskning_turkrav_post": 5
    },
    {
