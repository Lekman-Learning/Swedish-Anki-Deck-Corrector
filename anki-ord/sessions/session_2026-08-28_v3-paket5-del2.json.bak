    {
      "noteId": 1780080622297,
      "ord": "nihilism",
      "facit": "förnekande av normer",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Uppfattningen att ingenting egentligen finns eller har något värde ; en hållning som avvisar allt bestående utan att sätta något i stället ; historiskt: en revolutionär rörelse i 1800-talets Ryssland",
        "register": "fackspråklig, neutral, filosofi ; neutral, neutral, allmän ; neutral, neutral, historia",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Hans totala svartsyn och <font color=\"#3498db\">nihilism</font> gjorde honom omöjlig att diskutera med.",
        "etymologi": "Tyska Nihilismus; till latin nihil 'ingenting'."
      },
      "verdikt": "godkand",
      "anmarkning": "SO ger tre nyanser: filosofisk grundbetydelse (fornekande av allt vardefullt/existens), en allman avvisande hallning, och den historiska ryska rorelsen -- alla tre finns med pa kortet och ar ratt separerade med ' ; '. Etymologin (ty. Nihilismus, av lat. nihil) ar korrekt.",
      "granskning_turer_post": 45,
      "granskning_turkrav_post": 5
    },
    {
      "noteId": 1780080622259,
      "ord": "notabel",
      "facit": "anmärkningsvärd",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Värd att lägga märke till — tillräckligt ovanlig för att nämnas",
        "register": "formell, neutral, allmän",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "<font color=\"#3498db\">Notabelt</font> är det höga oddset på trean.",
        "etymologi": "Franska notable, latin notabilis; till notera."
      },
      "verdikt": "underkand",
      "anmarkning": "Kortet fangar bara betydelsen 'vard att lagga marke till, ovanlig' (SAOL: 'marklig'). Men SAOL:s fulla definition ar 'marklig; bemarkt, fornam' -- det finns alltsa ocksa en betydelse dar ordet beskriver en PERSON av hog stallning/framstaende rang (jfr slaktordet 'notabilitet' = framstaende person, och uttryck som 'notabla gaster' = framstaende gaster). Den betydelsen saknas helt, bade i huvudbetydelsen och i exempelmeningen (som bara illustrerar 'ovanlig'). Borde kompletteras med nagot i stil med 'ocksa om en person: framstaende, av hog samhallsstallning'.",
      "granskning_turer_post": 45,
      "granskning_turkrav_post": 5
    },
    {
      "noteId": 1780080622255,
      "ord": "orogenes",
      "facit": "bergskedjebildning<br><a href=\"https://www.google.com/imgres?q=orogenesis&amp;imgurl=https%3A%2F%2Fupload.wikimedia.org%2Fwikipedia%2Fcommons%2Fthumb%2F8%2F83%2FContinental-continental_convergence_Fig21contcont.gif%2F260px-Continental-continental_convergence_Fig21contcont.gif&amp;imgrefurl=https%3A%2F%2Fen.wikipedia.org%2Fwiki%2FOrogeny&amp;docid=EYRpGSbF2ZWGzM&amp;tbnid=p4A6UXK39Zwb-M&amp;vet=12ahUKEwiYkcXO4c6LAxWPcvEDHR6BHzYQM3oECBwQAA..i&amp;w=260&amp;h=149&amp;hcb=2&amp;ved=2ahUKEwiYkcXO4c6LAxWPcvEDHR6BHzYQM3oECBwQAA\"><div><div><div><img alt=\"Orogeny - Wikipedia\" src=\"paste-3f81f96240d463d2a64facc5f1d4e2a0db73b7ac.webp\"></div></div></div></a>",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Bildningen av bergskedjor, när rörelser i jordskorpan pressar upp berggrunden",
        "register": "fackspråklig, neutral, geologi",
        "synonymer": [
          "bergskedjebildning"
        ],
        "synonym_groups": null,
        "exempelmening": "Vid den senaste stora <font color=\"#3498db\">orogenesen</font> bildades Alperna.",
        "etymologi": "Grekiska oros 'berg' och genesis 'skapelse'; samma efterled som i genes."
      },
      "verdikt": "godkand",
      "anmarkning": "SO/SAOL ger en betydelse, bergskedjebildning genom rorelser i jordskorpan (veckning/overskjutning) -- matchar kortet och facit. Synonymen 'bergskedjebildning' ar i praktiken SAOL:s egen definition. Etymologin (gr. oros 'berg' + genesis 'skapelse') ar korrekt. (Facit-faltet innehaller ovidkommande skrapdata/en bildlank, men det paverkar inte bedomningen av sjalva kortet.)",
      "granskning_turer_post": 45,
      "granskning_turkrav_post": 5
    },
