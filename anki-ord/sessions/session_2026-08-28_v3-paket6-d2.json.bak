      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Helt uppfylld av en känsla eller en vilja ; om naturen eller döda ting: framställd som om den hade en själ",
        "register": "litterär, neutral, allmän ; litterär, neutral, litteraturvetenskap",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Hon var <font color=\"#3498db\">besjälad</font> av en vilja att hjälpa sina medmänniskor.",
        "etymologi": "Efter tyska beseelen; till sjal."
      },
      "verdikt": "godkand",
      "anmarkning": "SO (besjäla): huvudbetydelse (uppfylla någons tankar/själsliv, används ofta i participform 'besjälad') plus underbetydelse (ge själ åt döda ting/naturen). Kortet täcker båda korrekt.",
      "granskning_turer_post": 31,
      "granskning_turkrav_post": 5
    },
    {
