        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Man bör inte <font color=\"#3498db\">bagatellisera</font> miljöproblemen.",
        "etymologi": "Till bagatell, av franska bagatelle 'smasak'."
      },
      "verdikt": "godkand",
      "anmarkning": "SO: 'förringa betydelsen av'. Kortets 'låtsas som att något viktigt bara är en småsak' är en godtagbar, om än något friare, parafras av samma kärnbetydelse. Ingen betydelse saknas.",
      "granskning_turer_post": 31,
      "granskning_turkrav_post": 5
    },
