    },
    {
      "noteId": 1780080622342,
      "ord": "drittel",
      "facit": "smörtunna<br><a href=\"https://www.google.com/imgres?q=drittel&amp;imgurl=http%3A%2F%2Fwww.biopix.net%2Fphotos%2Fkan-drittel-00001.jpg&amp;imgrefurl=http%3A%2F%2Fwww.biopix.net%2Fdrittel_photo-38745.aspx&amp;docid=uCewuLLq-eFClM&amp;tbnid=rJgszZBD41HyRM&amp;vet=12ahUKEwjmkf3kuc6LAxVpXvEDHXymHm4QM3oECBkQAA..i&amp;w=640&amp;h=480&amp;hcb=2&amp;ved=2ahUKEwjmkf3kuc6LAxVpXvEDHXymHm4QM3oECBkQAA\"><div><div><div><img alt=\"Drittel foto - bild 38745\" src=\"paste-20b0c86062c306e5d84b38c03c261781cae986d9.webp\"></div></div></div></a>",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Träkärl av sammanfogade stavar som förr användes för att förvara smör ; också om det rymdmått ett sådant kärl rymde",
        "register": "neutral, neutral, historia ; neutral, neutral, historia",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Smöret packades i en <font color=\"#3498db\">drittel</font> för export till England.",
        "etymologi": "Danska drittel; av tyska Drittel 'tredjedel'."
      },
      "verdikt": "godkand",
      "anmarkning": "SAOL bekräftar uttryckligen båda betydelserna: 'tunna för förpackning av smör' OCH 'en volymenhet för smör'. Kortets två led (kärlet respektive rymdmåttet) stämmer exakt mot detta.",
      "granskning_turer_post": 31,
      "granskning_turkrav_post": 5
    },
    {
      "noteId": 1780080622382,
      "ord": "eufemism",
      "facit": "förskönande omskrivning",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Mildare ord som man sätter i stället för ett som känns obehagligt eller grovt",
        "register": "fackspråklig, neutral, lingvistik",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "\"Den lede\" är en <font color=\"#3498db\">eufemism</font> för \"fan\".",
        "etymologi": "Grekiska euphemismos 'anvandning av ett vackert ord for en dalig sak', till eu 'god' och pheme 'ord, sprak'."
      },
      "verdikt": "godkand",
      "anmarkning": "SO: en betydelse, 'förskönande omskrivning av något stötande uttryck', matchar kortet nästan ordagrant.",
      "granskning_turer_post": 31,
      "granskning_turkrav_post": 5
    },
    {
      "noteId": 1780080622355,
      "ord": "fog",
      "facit": "skarv; bra skäl",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Ställe där två delar i en konstruktion satts ihop ; i uttrycket \"knaka i fogarna\": hålla på att brista ; fullgott skäl — \"med fog\" ; i grammatiken: ljudet eller bokstaven som binder ihop två led i ett sammansatt ord",
        "register": "neutral, neutral, teknik ; neutral, neutral, allmän ; neutral, neutral, allmän ; fackspråklig, neutral, lingvistik",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Deras äktenskap knakar i <font color=\"#3498db\">fogarna</font>.",
        "etymologi": "Skarvbetydelsen av lagtyska voge, till vogen 'foga'. Skalbetydelsen fornsvenska fogh 'det som ar till pass' -- ett annat ord med annan historia; samma rot som ofog."
      },
      "verdikt": "godkand",
      "anmarkning": "SO ger två homografer (skarv/föreningsställe; fullgott skäl) och jag verifierade separat att skarv-homografen har en bekräftad underbetydelse 'äv. om sammanbindande ljud el. bokstav' (exempel: fogen i 'skogsbrand') -- exakt kortets fjärde, grammatiska betydelse. Alla fyra led samt idiomet 'knaka i fogarna' stämmer.",
