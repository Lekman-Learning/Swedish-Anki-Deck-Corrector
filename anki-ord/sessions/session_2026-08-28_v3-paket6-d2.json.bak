        "exempelmening": "Genom faderns konkurs blev familjen <font color=\"#3498db\">deklasserad</font>.",
        "etymologi": "Franska déclasser, till dé- 'itu' och classe 'klass'."
      },
      "verdikt": "godkand",
      "anmarkning": "SO: 'ge lägre rang eller status särsk. socialt' matchar kortet exakt.",
      "granskning_turer_post": 31,
