      "ord": "bondsk",
      "facit": "lantlig",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Som har drag som kännetecknar bönder och livet på en bondgård — enkelt och osminkat",
        "register": "neutral, neutral, allmän",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Möbler i en enkel, <font color=\"#3498db\">bondsk</font> stil.",
        "etymologi": null
      },
      "verdikt": "godkand",
      "anmarkning": "SO ger en betydelse ('kännetecknar bönder... enligt traditionella föreställningar') utan explicit negativ registeretikett i källan, trots att ett av SO:s exempel ('ett lite bondskt svar') har en mild nedsättande underton. Kortets neutrala register är därför försvarbart, om än ett gränsfall.",
      "granskning_turer_post": 31,
      "granskning_turkrav_post": 5
    },
    {
