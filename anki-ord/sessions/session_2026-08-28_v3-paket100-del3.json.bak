    {
      "noteId": 1780080622148,
      "ord": "eklatera",
      "facit": "offentliggöra förlovning",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Offentligt berätta om något som varit privat, framför allt en förlovning",
