        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "<font color=\"#3498db\">Konklaven</font> bekräftade påvevalet genom att sända ut vit rök.",
        "etymologi": "Latin conclave 'rum som kan lasas', till clavis 'nyckel' -- kardinalerna lases in tills de ar eniga."
      },
      "verdikt": "godkand",
      "anmarkning": "SO: slutet rum för hemliga överläggningar särsk. i katolska kyrkan, även om de deltagande (kardinalerna vid påveval) — matchar kortets betydelser väl.",
      "granskning_turer_post": 40,
      "granskning_turkrav_post": 6
    },
