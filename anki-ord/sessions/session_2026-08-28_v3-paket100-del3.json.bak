    {
      "noteId": 1780080622243,
      "ord": "gastkramning",
      "facit": "skräckfylld spänning",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Att gripas av en isande skräck som håller en fast ; i äldre folktro: att ha blivit antastad av en gast och vakna med blåmärken efter det",
        "register": "neutral, neutral, allmän ; ngt ålderdomlig, neutral, allmän",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Filmens sista halvtimme är en enda lång <font color=\"#3498db\">gastkramning</font>.",
        "etymologi": "Till gast 'spoke' och krama i den aldre betydelsen 'trycka hart'."
      },
      "verdikt": "godkand",
      "anmarkning": "Uppslagning delvis misslyckad: SO saknar egen post för substantivet (hänvisar till verbet 'gastkrama': 'hålla i skräckfylld spänning'), och SAOL:s post för 'gastkramning' gav ingen definitionstext, bara böjning/ämnesområde. Kortets moderna huvudbetydelse stämmer med verbets SO-betydelse; den äldre folktrobetydelsen kunde inte bekräftas i källorna men är rimlig utifrån etymologin och korrekt markerad som ålderdomlig. Döms försiktigt godkänd.",
      "granskning_turer_post": 40,
      "granskning_turkrav_post": 6
    },
