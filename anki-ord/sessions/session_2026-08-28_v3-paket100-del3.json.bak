        "synonym_groups": null,
        "exempelmening": "Notarien <font color=\"#3498db\">kollationerade</font> avskriften mot originalhandlingen.",
        "etymologi": "Medeltidslatin collationare 'sammanstalla, jamfora'; till kollation."
      },
      "verdikt": "godkand",
      "anmarkning": "SO ger två betydelser (kontrolläsa avskrift mot original; teaterns första läsrepetition) — matchar kortet. Synonymen 'motläsa' bekräftad i SAOL:s definition, inte cirkulär.",
      "granskning_turer_post": 40,
