      "ord": "cedilj",
      "facit": "hake under bokstaven c<br><a href=\"https://www.google.com/imgres?q=cedilj&amp;imgurl=https%3A%2F%2Fwww.shutterstock.com%2Fimage-illustration%2Flatin-c-cedilla-letter-on-600nw-1782773246.jpg&amp;imgrefurl=https%3A%2F%2Fwww.shutterstock.com%2Fsv%2Fsearch%2Fcedilj&amp;docid=eQi7PLbUfTkI2M&amp;tbnid=4tPgbp9IhHgYjM&amp;vet=12ahUKEwj9hq3-o92LAxUYHhAIHXveA3IQM3oECBYQAA..i&amp;w=600&amp;h=600&amp;hcb=2&amp;ved=2ahUKEwj9hq3-o92LAxUYHhAIHXveA3IQM3oECBYQAA\"><div><div><div><img alt=\"408 Cedilj royaltyfria fotografier och ...\" src=\"paste-36345289d91cdee8ae0827d7e495d5fd83925b2c.webp\"></div></div></div></a>",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Den lilla kroken under bokstaven c (ç), som visar att den ska uttalas som s",
        "register": "fackspråklig, neutral, lingvistik",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Franskans garçon skrivs med <font color=\"#3498db\">cedilj</font>.",
        "etymologi": "Franska cédille; av spanska cedilla 'litet c'."
      },
      "verdikt": "godkand",
      "anmarkning": "SO bekräftar definitionen exakt ('hakliknande tecken på c som markerar uttal som s'). Etymologin stämmer (fra. cédille; av sp. cedilla 'litet c'). En betydelse i SO, en på kortet — ingen lucka.",
      "granskning_turer_post": 40,
      "granskning_turkrav_post": 6
    },
    {
