      "facit": "jämföra",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Läsa igenom en avskrift mot originalet för att kontrollera att de stämmer överens ; inom teatern: hålla den första repetitionen, där hela pjäsen läses igenom",
        "register": "fackspråklig, neutral, allmän ; fackspråklig, neutral, konst",
