    {
      "noteId": 1780080622262,
      "ord": "patos",
      "facit": "lidelse",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Djup och brinnande känsla som märks i det man säger eller gör",
        "register": "neutral, neutral, allmän",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Hon talade med <font color=\"#3498db\">patos</font> om de förtryckta.",
        "etymologi": "Grekiska pathos 'lidande, lidelse, upplevelse'; samma rot som sympati, antipati, patetisk och telepati."
      },
      "verdikt": "godkand",
      "anmarkning": "SO: 'stark och lidelsefull känsla som vanligen tar sig högstämda uttryck'. Kortets 'djup och brinnande känsla som märks i det man säger eller gör' fångar kärnan, om än något mildare formulerad än SO:s 'högstämda uttryck'. Exempelmeningen är identisk med SO:s eget exempel. Enda betydelsen, ingen sakfel.",
      "granskning_turer_post": 27,
      "granskning_turkrav_post": 5
    },
    {
      "noteId": 1780080622250,
      "ord": "ranson",
      "facit": "portion",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Noga tilldelad mängd av något som det är ont om och som måste räcka",
        "register": "neutral, neutral, allmän",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Knappa <font color=\"#3498db\">ransoner</font> av bröd och socker delades ut.",
        "etymologi": "Via lagtyska av franska ration; av latin ratio 'rakning, berakning'; samma rot som ration och reson."
      },
      "verdikt": "godkand",
      "anmarkning": "SO: noga tilldelad/uppmätt mängd av något som kräver hushållning, särskilt mat, med en bildlig utvidgning ('dagens ranson skämthistorier') som en underordnad användning snarare än en egen huvudbetydelse. Kortets generella formulering ('av något som det är ont om') täcker båda. Exempelmeningen matchar SO:s kollokation 'knappa ransoner'.",
      "granskning_turer_post": 27,
      "granskning_turkrav_post": 5
    },
