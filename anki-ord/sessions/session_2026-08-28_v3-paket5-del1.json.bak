      "facit": "arbetskläder<br><a href=\"https://www.google.com/imgres?q=illustration%20bl%C3%A5st%C3%A4ll&amp;imgurl=https%3A%2F%2Fmedia.gettyimages.com%2Fid%2F1457403893%2Fsv%2Fvektor%2Fplumber-or-repair-man-set-of-worker-with-different-poses.jpg%3Fs%3D612x612%26w%3Dgi%26k%3D20%26c%3DlEofB4KnVK52c6G0fsvSs8RDZ0Jrlqj7oyZGztPlMN0%3D&amp;imgrefurl=https%3A%2F%2Fwww.gettyimages.se%2Fillustrationer%2Fbl%25C3%25A5st%25C3%25A4ll&amp;docid=7Hz1bbN5tJwf9M&amp;tbnid=txK2BYFSDOSNoM&amp;vet=12ahUKEwiRr8j0-PqLAxWgFBAIHWXxJgEQM3oECDIQAA..i&amp;w=612&amp;h=459&amp;hcb=2&amp;ved=2ahUKEwiRr8j0-PqLAxWgFBAIHWXxJgEQM3oECDIQAA\"><div><div><div><img alt=\"Illustrations - Getty Images | Snickare ...\" src=\"paste-abfcebf0295ec9b49cea07fc981e211a097d3a05.webp\"></div></div></div></a>",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Omgång blå överdragskläder som man drar på sig över de vanliga för kroppsarbete ; bildligt: att kavla upp ärmarna och slita",
        "register": "neutral, neutral, allmän ; neutral, neutral, allmän",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "I bortamatchen fick laget dra på sig <font color=\"#3498db\">blåstället</font> och jobba.",
        "etymologi": null
      },
      "verdikt": "godkand",
      "anmarkning": "SO: 'omgång blå överdragskläder för kroppsarbete', med en senare belagd bildlig användning om att kavla upp ärmarna och slita (bl.a. i sportsammanhang). Kortet har med båda, och exempelmeningen ('dra på sig blåstället och jobba' i en bortamatch) motsvarar precis SO:s egen bildliga användning i idrottskontext.",
      "granskning_turer_post": 27,
      "granskning_turkrav_post": 5
    }
