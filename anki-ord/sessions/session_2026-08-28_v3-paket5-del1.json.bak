        "synonym_groups": null,
        "exempelmening": "Golvet lades med <font color=\"#3498db\">spontat</font> virke.",
        "etymologi": null
      },
      "verdikt": "godkand",
      "anmarkning": "SO: 'förse (bräda el. dyl.) med spont', med utvidgad konstruktion för att beklä med spontat virke (t.ex. 'en spontad dörr'). Kortets två led (forma kanten resp. beklä en yta med sådana bräder) täcker exakt detta. Enda (sammansatta) betydelsen.",
      "granskning_turer_post": 27,
      "granskning_turkrav_post": 5
