    {
      "noteId": 1780080622251,
      "ord": "krås",
      "facit": "<br>inkråm; puffkrage<br><br><div><div><a href=\"https://www.google.com/imgres?q=kr%C3%A5s&amp;imgurl=https%3A%2F%2Fstatic.vecteezy.com%2Fsystem%2Fresources%2Fpreviews%2F017%2F392%2F313%2Fnon_2x%2Fchicken-gizzard-cuts-of-food-meat-watercolor-png.png&amp;imgrefurl=https%3A%2F%2Fsv.vecteezy.com%2Fpng%2F17392313-kyckling-kras-nedskarningar-av-mat-kott-vattenfarg&amp;docid=IYwwaZfSjbIKhM&amp;tbnid=594iv6vtfbkSNM&amp;vet=12ahUKEwibmfGEr8mLAxXKFhAIHa6oL5YQM3oECD0QAA..i&amp;w=954&amp;h=980&amp;hcb=2&amp;ved=2ahUKEwibmfGEr8mLAxXKFhAIHa6oL5YQM3oECD0QAA\"><img alt=\"kyckling krås. nedskärningar av mat ...\" src=\"images-e103dd98f8d2b6d16e61949ac50441eb058c49dd.webp\"></a><a href=\"https://www.google.com/imgres?q=kr%C3%A5s&amp;imgurl=https%3A%2F%2Fems.dimu.org%2Fimage%2F019EBtFZv7iUJ%3Fdimension%3D1200x1200&amp;imgrefurl=https%3A%2F%2Fdigitaltmuseum.se%2F0210212357288%2Fkras&amp;docid=aybAn6oRM5wzNM&amp;tbnid=d3XAAnBW5bYjlM&amp;vet=12ahUKEwibmfGEr8mLAxXKFhAIHa6oL5YQM3oECGYQAA..i&amp;w=1151&amp;h=1200&amp;hcb=2&amp;ved=2ahUKEwibmfGEr8mLAxXKFhAIHa6oL5YQM3oECGYQAA\"><div style=\"display: inline !important;\"><div style=\"display: inline !important;\"><div style=\"display: inline !important;\"><img alt=\"Krås -Dalarnas museum / DigitaltMuseum\" src=\"paste-0b798c3607da34ef00e64dfba37373dba85e70bf.webp\"></div></div></div></a></div></div>",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "De ätliga inälvorna i en fågel ; i uttrycket \"smörja kråset\": äta mycket och gott ; veckad remsa av tyg eller spets runt halsen eller vid ärmen",
        "register": "neutral, neutral, matlagning ; vardaglig, neutral, allmän ; neutral, neutral, allmän",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Hon firade sin examen med att smörja <font color=\"#3498db\">kråset</font> på stadens finaste krog.",
        "etymologi": "I inalvsbetydelsen fornsvenska (gaase)kraas, troligen av lagtyska kros 'inalvor i gas'. I tygbetydelsen efter tyska Krause, till kraus 'krusig' -- samma rot som krusa."
      },
      "verdikt": "godkand",
      "anmarkning": "SO listar två homografer: (1) ätliga inälvor i fågel, med idiomet 'smörja kråset', (2) veckad tygremsa/spets kring hals eller ärm. Kortet har med båda samt idiomet, i samma ordning som SO. Exempelmeningen matchar SO:s eget exempel nästan ordagrant ('restaurang' vs kortets 'krog', synonymt). Ingen betydelse saknas.",
      "granskning_turer_post": 27,
      "granskning_turkrav_post": 5
    },
