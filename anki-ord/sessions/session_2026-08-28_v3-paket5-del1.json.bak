    {
      "noteId": 1780080622252,
      "ord": "krum",
      "facit": "böjd och krokig<div><img src=\"paste-1e280c0c847844bf0788615859233d86b74090b7.webp\"><br></div>",
      "facit_signal": null,
      "kort": {
        "huvudbetydelse": "Krokig i formen, som något som har krökt sig ; som substantiv: själva kröken — \"med ryggen i krum\"",
        "register": "neutral, neutral, allmän ; neutral, neutral, allmän",
        "synonymer": [],
        "synonym_groups": null,
        "exempelmening": "Han stod med ryggen <font color=\"#3498db\">krum</font> över arbetsbänken.",
        "etymologi": "Lagtyska krum; beslaktat med kramp och krympa."
      },
      "verdikt": "underkand",
      "anmarkning": "Både SO och SAOL avgränsar adjektivbetydelsen till kropp/hållning -- SAOL taggar ordet med fackområdet 'med.', och SO:s enda exempel är kroppsliga ('krumma ben', 'en krum kropp', 'stod med ryggen krum'). Kortets huvudbetydelse ('Krokig i formen, som något som har krökt sig') är formulerad generellt, som om ordet gäller vilket böjt föremål som helst -- det är för brett och riskerar att läras in fel (t.ex. 'en krum pinne'). Borde specificera att det gäller böjd kropp/rygg, ofta pga sjukdom, ålder eller möda. Substantivbetydelsen ('själva kröken') stämmer dock med SAOL:s homograf 2.",
      "granskning_turer_post": 27,
      "granskning_turkrav_post": 5
    },
    {
